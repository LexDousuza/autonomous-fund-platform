# Copy this file to .env.live_trader and fill in real values:
#   cp .env.live_trader.example .env.live_trader
#
# .env.live_trader is gitignored - never commit real credentials.
# Used by scripts/run_live_paper_session.sh for unattended (cron) runs.

GROWW_API_KEY=your-real-api-key
GROWW_API_SECRET=your-real-api-secret

# Kite Connect (Zerodha) - from https://developers.kite.trade (create a
# "Connect" app first; the Connect API plan is a paid subscription).
# KITE_API_KEY/KITE_API_SECRET are the app's own credentials - set them
# once, they don't change day to day. KITE_ACCESS_TOKEN is different: it
# expires every day at 6 AM IST (a SEBI/regulatory requirement, not a
# bug), so run `python scripts/kite_generate_access_token.py` each
# trading morning to refresh it - that script logs the KITE_API_KEY/
# KITE_API_SECRET below and writes the resulting KITE_ACCESS_TOKEN line
# back into this file automatically.
KITE_API_KEY=your-real-api-key
KITE_API_SECRET=your-real-api-secret
KITE_ACCESS_TOKEN=

# SEBI's retail algo-trading framework (mandatory since 2026-04-01)
# requires every algo-placed order to carry a broker/exchange-issued
# algo-strategy id. Register this platform's strategy with your broker
# to obtain one - the live trader refuses to start against a real broker
# (LIVE_BROKER_PROVIDER=kite/groww) without this set. Separate from, and
# does not substitute for, static-IP whitelisting (handled at the
# network/hosting layer - see docs/runbooks/aws_integration.md).
LIVE_BROKER_ALGO_ID=

# Angel One (SmartAPI) - never a broker (no order placement built - see
# core/market_data/angelone_transport.py's module docstring), but usable
# as LIVE_MARKET_DATA_PROVIDER=angelone for a paper-broker session
# (historical bucket-selection data, and a poll-based live LTP feed with
# no volume/real trade-timestamp - see
# core/market_data/angelone_live_feed.py). Create an app at
# smartapi.angelbroking.com to get ANGELONE_API_KEY. ANGELONE_CLIENT_CODE
# is your Angel One trading account ID; ANGELONE_PASSWORD is your login
# PIN. ANGELONE_TOTP_SECRET is the base32 seed shown under the "TOTP" QR
# code when you enable 2FA on your account (not a 6-digit code itself -
# see core/utils/totp.py). Unlike Kite, this whole login flow is
# headless - no daily manual step needed.
ANGELONE_API_KEY=your-real-api-key
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Optional but strongly recommended once this runs unattended: without
# it, the only way to learn a session failed is to check
# data/alerts.log or data/cron_logs/*.log by hand. Any endpoint that
# accepts {"text": "..."} JSON works (Slack incoming webhook, ntfy.sh,
# Discord, etc.) - see core/notifications/alert_sink.py.
ALERT_WEBHOOK_URL=

# How many 5-second poll cycles to run for - default covers a full NSE
# trading day (9:15-15:30 IST) with margin. Only change this if you
# want a shorter/longer session.
LIVE_MAX_BARS=4500

# Optional: the HTTP dashboard and Obsidian sync auto-start alongside
# the trading session (idempotent - already-running ones are left
# alone, so this is safe to leave set every day).
DASHBOARD_PORT=8765
# Set to your vault path (e.g. /Users/neel/Claude) to also sync a live
# Markdown note into Obsidian; leave blank to skip that entirely.
OBSIDIAN_VAULT_PATH=

# Only needed if you want to reach the dashboard from somewhere other
# than this machine (e.g. your phone) - see "Reaching the dashboard from
# your phone" in docs/runbooks/daily_paper_trading.md. Leave both blank
# for the default (127.0.0.1, no login) if you're only ever viewing it
# locally or over an SSH tunnel.
DASHBOARD_AUTH_TOKEN=
DASHBOARD_HOST=
