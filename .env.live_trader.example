# Copy this file to .env.live_trader and fill in real values:
#   cp .env.live_trader.example .env.live_trader
#
# .env.live_trader is gitignored - never commit real credentials.
# Used by scripts/run_live_paper_session.sh for unattended (cron) runs.

GROWW_API_KEY=your-real-api-key
GROWW_API_SECRET=your-real-api-secret

# Kite Connect (Zerodha) - from https://developers.kite.trade (create a
# "Connect" app first; the Connect API plan is a paid subscription).
# KITE_API_KEY/KITE_API_SECRET are the app's own credentials - set them
# once, they don't change day to day. KITE_ACCESS_TOKEN is different: it
# expires every day at 6 AM IST (a SEBI/regulatory requirement, not a
# bug), so run `python scripts/kite_generate_access_token.py` each
# trading morning to refresh it - that script logs the KITE_API_KEY/
# KITE_API_SECRET below and writes the resulting KITE_ACCESS_TOKEN line
# back into this file automatically.
KITE_API_KEY=your-real-api-key
KITE_API_SECRET=your-real-api-secret
KITE_ACCESS_TOKEN=

# Optional but strongly recommended once this runs unattended: without
# it, the only way to learn a session failed is to check
# data/alerts.log or data/cron_logs/*.log by hand. Any endpoint that
# accepts {"text": "..."} JSON works (Slack incoming webhook, ntfy.sh,
# Discord, etc.) - see core/notifications/alert_sink.py.
ALERT_WEBHOOK_URL=

# How many 5-second poll cycles to run for - default covers a full NSE
# trading day (9:15-15:30 IST) with margin. Only change this if you
# want a shorter/longer session.
LIVE_MAX_BARS=4500

# Optional: the HTTP dashboard and Obsidian sync auto-start alongside
# the trading session (idempotent - already-running ones are left
# alone, so this is safe to leave set every day).
DASHBOARD_PORT=8765
# Set to your vault path (e.g. /Users/neel/Claude) to also sync a live
# Markdown note into Obsidian; leave blank to skip that entirely.
OBSIDIAN_VAULT_PATH=
