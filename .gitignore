# Python cache
__pycache__/
*.py[cod]

# Virtual env
.venv/

# macOS
.DS_Store

# Test / tool caches
.pytest_cache/
.mypy_cache/

# Runtime session artifacts (audit logs written per live-trader/kill-switch run)
data/live_sessions/
data/alerts.log
data/cron_logs/
