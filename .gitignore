# Python cache
__pycache__/
*.py[cod]

# Virtual env
.venv/

# macOS
.DS_Store

# Test / tool caches
.pytest_cache/
.mypy_cache/

# Runtime session artifacts (audit logs written per live-trader/kill-switch run)
data/live_sessions/
data/alerts.log
data/cron_logs/
data/candidate_selection/

# Real credentials for unattended cron runs - see .env.live_trader.example
.env.live_trader

# Third-party SmartApi SDK writes its own date-wise log file here
# (SmartConnect.__init__ calls logzero.logfile("logs/<date>/app.log")) and
# has logged raw Authorization/API-key headers on request failures - see
# core/market_data/angelone_transport.py's logging hardening. Never commit
# this even though it's mitigated in-process; defense in depth.
logs/

# 603MB, over GitHub's 100MB hard limit - regenerable from real NSE
# bhavcopy data via scripts/fetch_historical_options_nse.py, not hand-
# authored, so losing it from git costs nothing but a re-run.
data/processed/nse_index_options_iv_history.csv

# Intermediate data handoff between scripts/prepare_gap_continuation_
# crosscheck_data.py (this project's own venv) and scripts/vectorbt_
# cross_check_gap_continuation.py (an isolated venv - vectorbt needs
# pandas>=3.0.3, incompatible with growwapi's pandas<3.0.0 pin). 52MB,
# fully regenerable by re-running the prep script; the actual result
# lives in gap_continuation_vectorbt_crosscheck_results.json instead.
backtesting/gap_continuation_vectorbt_crosscheck/adjusted_bars.csv
backtesting/gap_continuation_vectorbt_crosscheck/vectorbt_trades.csv

